// sendoffapp.com on Cloudflare: the built site served as static assets, with no Worker code.
// Deploy with `npm run deploy`. public/_headers still applies. Public pages are files (/teams is
// teams.html). Private links go to the app: public/_redirects rewrites /s/* to /app (app.html), and
// only that, because Cloudflare applies redirect rules even to real files. Anything else that matches no
// file gets 404.html with a 404 status.
{
  "name": "sendoffapp",
  "compatibility_date": "2026-10-31",
  // The bare domain serves the site and /.well-known/apple-app-site-association itself; www is
  // sent here by a redirect rule on the zone.
  "routes": [{ "pattern": "sendoffapp.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
