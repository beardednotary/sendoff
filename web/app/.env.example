# Copy to .env.local (gitignored). Without these the site runs against the in-memory
# mock store with three demo Sendoffs, which is how the design is reviewed.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public origin used for links on the QR page and the landing page.
VITE_PUBLIC_ORIGIN=https://sendoffapp.com
