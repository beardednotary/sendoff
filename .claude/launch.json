{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "web/prototype"],
      "port": 8765
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web/app", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "web-live-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web/app", "run", "preview", "--", "--port", "4180", "--strictPort"],
      "port": 4180
    }
  ]
}
